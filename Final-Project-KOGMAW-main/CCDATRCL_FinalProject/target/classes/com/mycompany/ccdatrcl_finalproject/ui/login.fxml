<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="0" styleClass="page-root" stylesheets="@customer.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ccdatrcl_finalproject.ui.LoginController">
    <children>
        <VBox maxWidth="680" prefWidth="680" styleClass="card-modal">
            <children>
            <AnchorPane>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <children>
                      <HBox alignment="CENTER_RIGHT" layoutX="384.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="30.0" prefWidth="200.0" />
                      <Label layoutY="9.0" styleClass="section-title" text="Admin Login" textAlignment="CENTER">
                </Label>
                       <Button layoutX="598.0" layoutY="-1.0" mnemonicParsing="false" onAction="#handleBack" styleClass="close-button" text="×" />
               </children>
            </AnchorPane>
                 <Label prefHeight="69.0" prefWidth="282.0" styleClass="form-brand" text="KOGMAW">
               <effect>
                  <Glow />
               </effect>
            </Label>
            <AnchorPane>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
               <children>
                      <VBox spacing="4">
                          <Label styleClass="form-label" text="User" />
                          <TextField fx:id="usernameField" prefHeight="37.0" prefWidth="614.0" promptText="Enter email address" styleClass="pill-input" />
                          <Label styleClass="form-label" text="Password">
                              <VBox.margin>
                                  <Insets top="12" />
                              </VBox.margin>
                          </Label>
                          <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Enter password" styleClass="pill-input" />
                      </VBox>
               </children>
            </AnchorPane>
                <Label styleClass="divider" text="">
                    <VBox.margin>
                        <Insets bottom="15" />
                    </VBox.margin>
                </Label>
            <AnchorPane>
               <children>
                      <VBox spacing="1" />
               </children>
            </AnchorPane>
                <HBox alignment="CENTER_RIGHT">
                    <VBox.margin>
                        <Insets top="18" />
                    </VBox.margin>
                    <Button fx:id="loginBtn" mnemonicParsing="false" onAction="#handleLogin" styleClass="dark-button" text="Log in">
                  <effect>
                     <Glow />
                  </effect></Button>
                </HBox>
                <Label styleClass="divider" text="">
                    <VBox.margin>
                        <Insets top="15" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </children>
</VBox>
