<AnchorPane prefHeight="592.0" prefWidth="774.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ccdatrcl_finalproject.ui.LoginController">
   <children>
      <VBox id="bg" fx:id="gradientAnim" alignment="CENTER" maxWidth="300.0" prefHeight="678.0" prefWidth="509.0" stylesheets="@login.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
