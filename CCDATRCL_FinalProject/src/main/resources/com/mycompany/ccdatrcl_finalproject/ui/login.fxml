               <font>
                  <Font name="JetBrainsMonoNL NF Regular" size="96.0" />
               </font>
               <padding>
                  <Insets top="-250.0" />
               </padding>
               <effect>
                  <Glow level="0.74" />
               </effect>
            </Label>
            <TextField id="ufield" fx:id="usernameField" alignment="CENTER" prefHeight="45.0" prefWidth="305.0" promptText="Username" style="-fx-background-radius: 10;" stylesheets="@login.css">
               <VBox.margin>
                  <Insets left="100.0" right="100.0" />
               </VBox.margin>
               <effect>
                  <DropShadow height="18.95" radius="8.745000000000001" spread="0.16" width="18.03" />
