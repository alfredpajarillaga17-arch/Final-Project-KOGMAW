<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ccdatrcl_finalproject.ui.DashboardController">
    
    <!-- SIDEBAR -->
    <left>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #2c3e50;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="K.O.G.M.A.W." />
            <Button maxWidth="Infinity" onAction="#showDashboardView" text="Dashboard" />
            <Button maxWidth="Infinity" onAction="#showCreateApptView" text="New Ticket" />
            <Button maxWidth="Infinity" onAction="#showSearchView" text="Search Ticket" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" text="Logout" />
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane style="-fx-padding: 20;">
            
            <!-- VIEW 1: DASHBOARD -->
            <VBox fx:id="dashboardView" spacing="10">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Active Repair Dashboard" />
                <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="100" text="Ticket ID" />
                        <TableColumn fx:id="colName" prefWidth="150" text="Customer Name" />
                        <TableColumn fx:id="colContactNumber" prefWidth="150" text="Contact Number" />
                        <TableColumn fx:id="colDevice" prefWidth="143.0" text="Device" />
                        <TableColumn fx:id="colBrand" prefWidth="150" text="Brand" />
                        <TableColumn fx:id="colModel" prefWidth="150" text="Model" />
                        <TableColumn fx:id="colIssue" prefWidth="143.0" text="Issue" />
                        <TableColumn fx:id="colDate" prefWidth="150" text="Date" />
                        <TableColumn fx:id="colPhase" prefWidth="114.0" text="Phase" />
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button onAction="#handleProcessNextTicket" text="Process Next" />
                    <Button onAction="#handleUndoLastEntry" text="Undo Last" />
                    <Button onAction="#handleCheckWorkflowSteps" text="Map BFS" />
                    <Button onAction="#handleCheckWorkflowStepsDFS" text="Map DFS" />
                    <Button onAction="#handleSortByDate" text="Sort (Date)" />
                    <Button onAction="#handleSortByName" text="Sort (Name)" />
                    <Button onAction="#handleExportHistoryLog" text="Export Log" />
                </HBox>
            </VBox>

            <!-- VIEW 2: CREATE APPOINTMENT -->
            <VBox fx:id="createApptView" spacing="15" visible="false">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Intake New Gadget" />
                <GridPane hgap="10" vgap="15">
                    <Label text="Customer Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="customerNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Contact Number:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="contactNumberField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    
                    <Label text="Device Type:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="deviceCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    
                    <Label text="Brand:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="brandField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    
                    <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    
                    <Label text="Reported Issue:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <TextField fx:id="issueField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    
                    <Label text="Initial Phase:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <ComboBox fx:id="phaseCombo" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
                <Button onAction="#handleSaveAppointment" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Save Appointment" />
            </VBox>

            <!-- VIEW 3: SEARCH TICKET -->
            <VBox fx:id="searchView" spacing="15" visible="false">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Search &amp; Update Ticket" />
                <HBox spacing="10">
                    <TextField fx:id="searchIdField" promptText="Enter KGW-XXX" />
                    <Button onAction="#handleSearch" text="Search" />
                </HBox>
                <VBox spacing="10" style="-fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-padding: 15;">
                    <Label fx:id="searchResultName" text="Name: " />
                    <Label fx:id="searchResultDevice" text="Device: " />
                    <Label fx:id="searchResultIssue" text="Issue: " />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Update Phase:" />
                        <ComboBox fx:id="updatePhaseCombo" />
                        <Button onAction="#handleUpdatePhase" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Update" />
                        <Button onAction="#handleDeleteFromSearch" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Delete Ticket" />
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
