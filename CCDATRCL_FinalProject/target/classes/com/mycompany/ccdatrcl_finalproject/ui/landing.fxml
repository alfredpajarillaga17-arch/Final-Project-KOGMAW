<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ccdatrcl_finalproject.ui.LandingController"
      alignment="CENTER"
      spacing="0"
      styleClass="landing-root"
      stylesheets="@customer.css">
    <children>
        <VBox alignment="CENTER" spacing="0" maxWidth="680" VBox.vgrow="ALWAYS">
            <Label text="WELCOME TO" styleClass="welcome-text" />
            <Label text="KOGMAW" styleClass="title-kogmaw" />
            <Label text="We don't just repair, we revive." styleClass="subtitle-text" />
            <Button text="Book now" onAction="#handleBookNow" styleClass="book-now-button">
                <VBox.margin>
                    <javafx.geometry.Insets top="38" right="0" bottom="0" left="0"/>
                </VBox.margin>
            </Button>
        </VBox>

        <Button text="admin login"
                onAction="#handleAdminLogin"
                styleClass="admin-link"
                mnemonicParsing="false">
            <VBox.margin>
                <javafx.geometry.Insets top="0" right="0" bottom="34" left="0"/>
            </VBox.margin>
        </Button>
    </children>
</VBox>
